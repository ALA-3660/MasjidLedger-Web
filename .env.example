# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Local PostgreSQL database connection string for MasjidLedger Pro v2.6.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/masjidledger_v26_runtime_test"

# PRODUCTION AUTHENTICATION (SIGNED JWT & REFRESH TOKEN)
JWT_ACCESS_SECRET="CHANGE_ME_TO_STRONG_RANDOM_SECRET_KEY"
JWT_REFRESH_SECRET="CHANGE_ME_TO_DIFFERENT_STRONG_RANDOM_SECRET_KEY"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
